page {
  background-color: #f1f5f9;
}

.container {
  min-height: 100vh;
  position: relative;
}

/* ================= 导航栏 ================= */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  z-index: 999;
  display: flex;
  align-items: center;
  box-sizing: content-box; /* 强制取消挤压 */
}
.nav-back { 
  position: absolute; 
  left: 0; 
  padding: 0 32rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  z-index: 1000; 
}
.back-icon { 
  font-size: 36rpx; 
  color: #1e293b; 
  font-weight: bold; 
}
.nav-title { 
  width: 100%; 
  text-align: center; 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #1e293b; 
}

.loading { 
  text-align: center; 
  padding: 100rpx; 
  color: #94a3b8; 
}

/* ================= 封面图 ================= */
.cover-area { 
  width: 100%; 
  height: 640rpx; 
  background-color: #e2e8f0; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  overflow: hidden; 
}
.cover-img { 
  width: 100%; 
  height: 100%; 
  object-fit: cover; 
}
.cover-placeholder { 
  font-size: 160rpx; 
  color: #94a3b8; 
}

/* ================= 卡片通用基础 ================= */
.info-card, .desc-card, .delivery-card { 
  background-color: #ffffff; 
  margin: 24rpx; 
  border-radius: 24rpx; 
  padding: 32rpx; 
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03); 
}

/* ================= 核心信息排版 ================= */
.title { 
  font-size: 38rpx; 
  font-weight: 900; 
  color: #1e293b; 
  line-height: 1.4; 
  margin-bottom: 12rpx; 
  display: block; 
}
.author { 
  font-size: 26rpx; 
  color: #64748b; 
  margin-bottom: 24rpx; 
  display: block; 
}

.price-row { 
  display: flex; 
  align-items: baseline; 
  margin-bottom: 24rpx; 
}
.price-symbol { 
  font-size: 32rpx; 
  color: #f97316; 
  font-weight: bold; 
}
.price { 
  font-size: 64rpx; 
  color: #f97316; 
  font-weight: 900; 
  margin-right: 16rpx; 
  line-height: 1; 
}
.orig-price { 
  font-size: 26rpx; 
  color: #94a3b8; 
  text-decoration: line-through; 
}
.saved-tag { 
  margin-left: 16rpx; 
  background-color: #ffedd5; 
  color: #ea580c; 
  font-size: 22rpx; 
  padding: 6rpx 16rpx; 
  border-radius: 12rpx; 
  font-weight: bold; 
}

.tags-row { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 16rpx; 
}
.badge { 
  font-size: 24rpx; 
  padding: 8rpx 20rpx; 
  border-radius: 12rpx; 
  font-weight: bold; 
  color: #ffffff; 
}
.badge-default { background-color: #f1f5f9; color: #64748b; }
.cond-quanxin { background-color: #22c55e; color: #fff;}
.cond-jiuchenxin { background-color: #3b82f6; color: #fff;}
.cond-bachenxin { background-color: #f59e0b; color: #fff;}
.cond-qichenxin { background-color: #ef4444; color: #fff;}

/* ================= 描述区域 ================= */
.section-title { 
  font-size: 30rpx; 
  font-weight: 800; 
  color: #1e293b; 
  margin-bottom: 24rpx; 
  display: block; 
}
.desc-text { 
  font-size: 28rpx; 
  color: #475569; 
  line-height: 1.6; 
  display: block; 
}

/* ================= 交易方式区域 ================= */
.radio-group { 
  display: flex; 
  flex-direction: column; 
  gap: 32rpx; 
}
.radio-label { 
  display: flex; 
  align-items: center; 
  font-size: 28rpx; 
  color: #334155; 
  font-weight: bold; 
}
.radio-label radio { 
  transform: scale(0.85); 
  margin-right: 12rpx; 
}
.pickup-address { 
  font-size: 26rpx; 
  color: #ea580c; 
  background: #ffedd5; 
  padding: 20rpx 24rpx; 
  border-radius: 16rpx; 
  margin-top: -12rpx; 
  margin-left: 60rpx; 
  font-weight: 500;
}

/* ================= 底部悬浮操作栏 ================= */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.admin-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 32rpx;
  gap: 24rpx;
}
.btn-edit, .btn-delete { 
  flex: 1; 
  height: 88rpx; 
  line-height: 88rpx; 
  text-align: center; 
  border-radius: 44rpx; 
  font-size: 30rpx; 
  font-weight: bold; 
}
.btn-edit { background-color: #f1f5f9; color: #334155; }
.btn-delete { background-color: #fee2e2; color: #ef4444; }

.user-actions {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
}
.contact-btn { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  margin-right: 32rpx; 
}
.contact-icon { 
  font-size: 44rpx; 
  margin-bottom: 4rpx; 
}
.contact-text { 
  font-size: 22rpx; 
  color: #64748b; 
  font-weight: 500; 
}
.cart-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff3e0;
  color: #ea580c;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: bold;
  padding: 0 28rpx;
  margin-right: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.cart-btn:active { background: #ffe0b2; }
.btn-disabled {
  background: #cbd5e1 !important;
  color: #fff !important;
}

.buy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #f97316, #fb923c);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(249, 115, 22, 0.25);
}
.buy-btn-disabled {
  background: #cbd5e1 !important;
  color: #ffffff !important;
  box-shadow: none !important;
}
/* 收藏按钮（与聊一聊同为图标+文字竖排） */
.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
}
.icon-btn-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}
.icon-btn-text {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}
