.container { min-height: 100vh; background: #f1f5f9; }

.custom-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 99;
  background: #fff; display: flex; align-items: center; padding: 0 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
}
.nav-back { display: flex; align-items: center; padding-right: 16rpx; }
.back-icon { font-size: 34rpx; color: #334155; }
.nav-title { flex: 1; font-size: 32rpx; font-weight: 600; color: #1e293b; text-align: center; margin-right: 40rpx; }

.loading { text-align: center; color: #94a3b8; padding: 120rpx 0; font-size: 28rpx; }

/* 卡片 */
.card {
  margin: 24rpx; background: #fff; border-radius: 20rpx;
  padding: 32rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-title { font-size: 30rpx; font-weight: 600; color: #1e293b; display: block; margin-bottom: 24rpx; }

/* 书籍条目 */
.book-item { display: flex; align-items: center; margin-bottom: 20rpx; }
.book-thumb { width: 90rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; }
.book-thumb-ph { width: 90rpx; height: 120rpx; border-radius: 12rpx; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 40rpx; flex-shrink: 0; }
.book-meta { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.book-name { font-size: 28rpx; color: #334155; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.book-price { font-size: 32rpx; font-weight: 600; color: #f97316; }

.divider { height: 1rpx; background: #e2e8f0; margin: 24rpx 0; }

/* 金额明细 */
.amount-row { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #64748b; margin-bottom: 16rpx; }
.amount-row.total { margin-top: 8rpx; margin-bottom: 0; }
.total-num { font-size: 40rpx; font-weight: 700; color: #f97316; }

/* 收款二维码 */
.qrcode-card { text-align: center; }
.qrcode-wrap {
  width: 360rpx; height: 360rpx; margin: 0 auto 24rpx;
  border-radius: 16rpx; border: 2rpx dashed #cbd5e1;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; background: #f8fafc;
}
.qrcode-img { width: 100%; height: 100%; }
.qrcode-placeholder { font-size: 26rpx; color: #94a3b8; }
.qrcode-tips { text-align: left; padding: 0 8rpx; }
.qrcode-tip { font-size: 26rpx; color: #64748b; line-height: 2; display: block; }
.tip-highlight { color: #f97316; font-weight: 600; }

/* 底部栏 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; display: flex; align-items: center;
  justify-content: space-between; padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}
.total-wrap { display: flex; flex-direction: column; }
.total-label { font-size: 24rpx; color: #94a3b8; }
.total-price { font-size: 44rpx; font-weight: 700; color: #f97316; }
.pay-btn {
  background: #f97316; color: #fff; font-size: 30rpx; font-weight: 600;
  padding: 20rpx 56rpx; border-radius: 48rpx;
}
.pay-btn.btn-disabled { opacity: 0.6; }

/* 成功页 */
.success-card {
  margin: 120rpx 48rpx 0; background: #fff; border-radius: 24rpx;
  padding: 64rpx 48rpx; display: flex; flex-direction: column;
  align-items: center; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.success-icon-wrap {
  width: 120rpx; height: 120rpx; border-radius: 60rpx;
  background: #22c55e; display: flex; align-items: center;
  justify-content: center; margin-bottom: 32rpx;
}
.success-icon { font-size: 60rpx; color: #fff; font-weight: 700; }
.success-title { font-size: 36rpx; font-weight: 600; color: #1e293b; margin-bottom: 16rpx; }
.success-amount { font-size: 56rpx; font-weight: 700; color: #f97316; margin-bottom: 8rpx; }
.success-hint { font-size: 24rpx; color: #94a3b8; margin-bottom: 48rpx; }
.success-btn {
  width: 100%; text-align: center; background: #f97316;
  color: #fff; font-size: 30rpx; font-weight: 600;
  padding: 24rpx; border-radius: 48rpx;
}
