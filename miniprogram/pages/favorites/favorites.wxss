page {
  background-color: #f1f5f9;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 导航栏（与详情页同款自定义导航） */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #f1f5f9;
  z-index: 999;
  display: flex;
  align-items: center;
}
.nav-back {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.back-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e293b;
}
.nav-title {
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

/* 收藏列表 */
.fav-list {
  padding: 24rpx 32rpx;
}
.fav-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.fav-card:active {
  background: #f8fafc;
}
.book-cover-wrap {
  position: relative;
  flex-shrink: 0;
}
.book-cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}
.book-cover-placeholder {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.condition-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #94a3b8;
}
.cond-other {
  background: #94a3b8;
}
.book-info {
  flex: 1;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.book-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-author {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}
.book-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.book-price {
  font-size: 34rpx;
  font-weight: 800;
  color: #ea580c;
}
.book-orig {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-left: 12rpx;
}
.off-shelf-tag {
  margin-top: 10rpx;
  align-self: flex-start;
  font-size: 20rpx;
  color: #ef4444;
  background: #fee2e2;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 取消收藏 */
.fav-remove {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
}
.fav-remove-text {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 状态与空态 */
.load-more {
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  font-size: 100rpx;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #94a3b8;
}
.loading-state {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  padding: 40rpx 0;
}
