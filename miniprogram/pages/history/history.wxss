page {
  background-color: #f1f5f9;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 导航栏（与聊天页同款 flex 结构：标题自动避开返回键/清空/胶囊） */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #f1f5f9;
  z-index: 999;
  display: flex;
  align-items: center;
}
.nav-back {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  z-index: 1000;
}
.back-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: #1e293b;
}
.nav-title {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding-left: 90rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nav-clear {
  flex-shrink: 0;
  padding: 0 8rpx 0 24rpx;
  color: #64748b;
  font-size: 26rpx;
}
.nav-clear-disabled {
  opacity: 0.4;
}
.nav-capsule-gap {
  flex-shrink: 0;
}

/* 历史列表 */
.history-list {
  padding: 24rpx 32rpx;
}
.history-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.history-card:active {
  transform: scale(0.98);
  background: #f8fafc;
}
.book-cover-wrap {
  position: relative;
  flex-shrink: 0;
}
.book-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}
.book-cover-placeholder {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.condition-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #94a3b8;
}
.cond-other {
  background: #94a3b8;
}
.book-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.book-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #ea580c;
  margin-top: 10rpx;
}
.book-time {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}

.list-foot {
  text-align: center;
  color: #cbd5e1;
  font-size: 24rpx;
  padding: 20rpx 0;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  font-size: 100rpx;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #94a3b8;
}
