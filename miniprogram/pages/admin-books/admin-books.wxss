page { 
  background-color: #f1f5f9; 
}

/* ================= 导航栏 ================= */
.custom-nav { 
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  background: #ffffff; 
  z-index: 999; 
  display: flex; 
  align-items: center; 
}
.nav-back { 
  position: absolute; 
  left: 0; 
  padding: 0 32rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  z-index: 1000; 
}
.back-icon { 
  font-size: 36rpx; 
  color: #1e293b; 
  font-weight: bold; 
}
.nav-title { 
  width: 100%; 
  text-align: center; 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #1e293b; 
}

/* ================= 顶部状态切换 Tab ================= */
.tab-bar {
  display: flex;
  background: #ffffff;
  padding: 0 32rpx;
  position: sticky;
  top: 0;
  z-index: 998;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
  padding: 24rpx 0;
  position: relative;
  transition: all 0.2s ease;
}
.tab-active {
  color: #1e293b;
  font-weight: 900;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #1e293b;
  border-radius: 6rpx 6rpx 0 0;
}

/* ================= 书籍列表区域 ================= */
.book-list {
  padding: 24rpx;
}
.book-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

/* 书籍信息展示块 */
.book-content {
  display: flex;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #e2e8f0;
}
.book-thumb, .book-thumb-ph {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.book-thumb-ph {
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}
.book-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}
.book-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.book-price {
  font-size: 36rpx;
  font-weight: 900;
  color: #1e293b; /* 极简黑白灰风格 */
  margin-bottom: 16rpx;
}
.book-orig {
  font-size: 24rpx;
  color: #94a3b8;
  text-decoration: line-through;
  font-weight: normal;
  margin-left: 12rpx;
}
.book-meta {
  font-size: 24rpx;
  color: #64748b;
  margin-top: auto;
}

/* ================= 底部操作按钮 ================= */
.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}
.btn {
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
}
.btn-edit {
  background: #f1f5f9;
  color: #334155;
}
.btn-danger {
  background: #fee2e2;
  color: #ef4444;
}
.btn-success {
  background: #1e293b; /* 极简高级黑 */
  color: #ffffff;
}
.btn-disabled {
  background: #f8fafc;
  color: #cbd5e1;
}
.btn-delete {
  background: #fee2e2;
  color: #ef4444;
}

/* ================= 页面空白与加载状态 ================= */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-text {
  color: #94a3b8;
  font-size: 28rpx;
}
.loading {
  text-align: center;
  color: #94a3b8;
  padding: 60rpx;
  font-size: 28rpx;
}