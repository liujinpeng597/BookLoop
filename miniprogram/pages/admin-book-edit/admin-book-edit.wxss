page {
  background-color: #f1f5f9;
}

.container {
  padding-bottom: 160rpx; 
}

/* 顶部导航 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #f1f5f9;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: content-box;
}

.nav-title {
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

/* 标题区 */
.header-section {
  padding: 40rpx 32rpx 30rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 封面卡片 */
.cover-card {
  margin: 0 32rpx 30rpx;
  background: #ffffff;
  border-radius: 32rpx;
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #94a3b8;
}

.add-icon {
  font-size: 80rpx;
  font-weight: 300;
  margin-bottom: 10rpx;
  color: #cbd5e1;
}

.add-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* ISBN 扫码按钮 */
.scan-btn {
  width: 64rpx;
  height: 64rpx;
  background: #fff3e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.scan-btn:active {
  background: #ffe0b2;
  transform: scale(0.92);
}
.scan-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 通用表单卡片 */
.card {
  background: #ffffff;
  margin: 0 32rpx 30rpx;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.input-item {
  display: flex;
  align-items: center;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.input-item:last-child {
  border-bottom: none;
}

.input-item.block {
  flex-direction: column;
  align-items: flex-start;
}

.input-item.block input {
  width: 100%;
  margin-top: 20rpx;
  text-align: left;
  background: #f8fafc;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #334155;
  width: 200rpx;
  flex-shrink: 0;
}

input {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  text-align: right;
}

/* 选择器专属 */
.picker-item {
  padding: 36rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-content {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #f97316;
  font-weight: bold;
}

/* 价格专属排版 */
.price-input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 0;
}

.price-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.price-item.orig {
  border-left: 2rpx solid #f1f5f9;
  padding-left: 32rpx;
  margin-left: 32rpx;
}

.price-item .label {
  width: auto;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #64748b;
}

.price-item input {
  text-align: left;
  font-size: 56rpx;
  font-weight: 900;
  color: #f97316;
  height: 70rpx;
  min-height: 70rpx;
}

.price-item.orig input {
  color: #94a3b8;
  font-size: 36rpx;
  font-weight: normal;
}

/* 详细描述 */
.desc-item {
  padding: 36rpx 0;
  position: relative;
  display: flex;
  flex-direction: column;
}

textarea {
  width: 100%;
  height: 220rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.6;
  margin-top: 24rpx;
  background: #f8fafc;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
}

.word-count {
  position: absolute;
  right: 24rpx;
  bottom: 60rpx;
  font-size: 22rpx;
  color: #cbd5e1;
  background: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.btn-cancel {
  width: 32% !important;
  background: #f1f5f9;
  color: #475569;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
}

.btn-submit {
  width: 63% !important;
  background: linear-gradient(135deg, #f97316, #fb923c);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 8rpx 20rpx rgba(249, 115, 22, 0.25);
}