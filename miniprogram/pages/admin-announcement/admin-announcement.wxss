page { background: #f1f5f9; }

.custom-nav { position: fixed; top: 0; left: 0; width: 100%; background: #fff; z-index: 999; display: flex; align-items: center; box-sizing: content-box; }
.nav-back { position: absolute; left: 0; padding: 0 32rpx; display: flex; align-items: center; justify-content: center; z-index: 1000; }
.back-icon { font-size: 36rpx; color: #1e293b; font-weight: bold; }
.nav-title { width: 100%; text-align: center; font-size: 34rpx; font-weight: bold; color: #1e293b; }

.form-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}
.form-title { font-size: 30rpx; font-weight: 800; color: #1e293b; display: block; margin-bottom: 24rpx; }
.textarea {
  width: 100%; background: #f8fafc; border-radius: 16rpx; font-size: 28rpx; color: #1e293b;
  padding: 24rpx; height: 240rpx; line-height: 1.6; box-sizing: border-box;
}
.char-count { text-align: right; font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; display: block; }

.submit-btn {
  background: linear-gradient(135deg, #f97316, #fb923c); color: #fff; text-align: center;
  padding: 24rpx; border-radius: 44rpx; font-size: 32rpx; font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(249,115,22,0.25); margin-top: 20rpx;
}
.btn-disabled { background: #cbd5e1 !important; box-shadow: none !important; }

.history-section { margin: 0 24rpx 40rpx; }
.history-title { font-size: 28rpx; font-weight: 800; color: #64748b; display: block; margin-bottom: 20rpx; }
.loading, .empty { text-align: center; color: #94a3b8; font-size: 26rpx; padding: 40rpx; }

.announce-list { display: flex; flex-direction: column; gap: 16rpx; }
.announce-item {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  display: flex; align-items: center; gap: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}
.announce-body { flex: 1; min-width: 0; }
.announce-text { font-size: 26rpx; color: #1e293b; line-height: 1.5; display: block; }
.announce-time { font-size: 22rpx; color: #94a3b8; margin-top: 8rpx; display: block; }
.btn-delete {
  font-size: 22rpx; color: #ef4444; background: #fee2e2; padding: 10rpx 24rpx;
  border-radius: 20rpx; flex-shrink: 0;
}
