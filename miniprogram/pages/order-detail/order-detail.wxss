page {
  background-color: #f1f5f9;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  z-index: 999;
  display: flex;
  align-items: center;
  box-sizing: content-box;
}
.nav-back {
  position: absolute;
  left: 0;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.back-icon {
  font-size: 36rpx;
  color: #1e293b;
  font-weight: bold;
}
.nav-title {
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #94a3b8;
}

/* 状态卡片 */
.status-card {
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.status-pending { background: #fff7ed; }
.status-shipped { background: #eff6ff; }
.status-completed { background: #f0fdf4; }
.status-cancelled { background: #f1f5f9; }
.status-icon { font-size: 64rpx; }
.status-text {
  font-size: 36rpx;
  font-weight: 900;
}
.status-pending .status-text { color: #f97316; }
.status-shipped .status-text { color: #3b82f6; }
.status-completed .status-text { color: #10b981; }
.status-cancelled .status-text { color: #94a3b8; }
.status-no {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 支付状态 */
.pay-status-badge {
  margin-top: 16rpx;
  padding: 8rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.pay-status-badge.paid {
  background: #d1fae5;
  color: #059669;
}
.pay-status-badge.unpaid {
  background: #fef3c7;
  color: #d97706;
}
/* 买家已自报转账、待卖家核实 */
.pay-status-badge.claim {
  background: #ffedd5;
  color: #ea580c;
}

.pay-now-btn {
  margin-top: 20rpx;
  background: #f97316;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 48rpx;
  border-radius: 48rpx;
}

/* 买家自助取消订单（待交接且未支付时显示） */
.cancel-btn {
  margin-top: 12rpx;
  background: #fff;
  color: #64748b;
  font-size: 26rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  border: 1rpx solid #e2e8f0;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}
.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
  display: block;
  margin-bottom: 24rpx;
}

/* 书籍条目 */
.book-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.book-item:last-child { border-bottom: none; }
.book-thumb, .book-thumb-ph {
  width: 100rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.book-thumb-ph {
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.book-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.book-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 10rpx;
}
.book-price {
  font-size: 34rpx;
  color: #ea580c;
  font-weight: 900;
}

/* 价格汇总 */
.price-summary {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.price-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #64748b;
}
.price-row.total {
  font-weight: 800;
  color: #1e293b;
  font-size: 32rpx;
  margin-top: 8rpx;
}
.total-num {
  color: #ea580c;
  font-weight: 900;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 500;
}
.info-value {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 600;
}
