<view class="container">
  <view class="custom-nav" style="padding-top: {{navTop}}px; height: {{navHeight}}px; box-sizing: content-box;">
    <view class="nav-back" style="height: {{navHeight}}px;" bindtap="onBackTap">
      <text class="back-icon">◁</text>
    </view>
    <view class="nav-title" style="height: {{navHeight}}px; line-height: {{navHeight}}px;">订单详情</view>
  </view>
  <view style="height: {{navTop + navHeight}}px; background-color: #f1f5f9;"></view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:elif="{{order}}">
    <!-- 状态卡片 -->
    <view class="status-card status-{{order.status}}">
      <text class="status-icon">
        {{order.status === 'pending' ? '⏳' : (order.status === 'shipped' ? '📦' : (order.status === 'completed' ? '✅' : '❌'))}}
      </text>
      <text class="status-text">{{statusMap[order.status]}}</text>
      <text class="status-no">订单号：{{order.orderNo}}</text>
      <view class="pay-status-badge {{order.paid ? (order.adminConfirmedPaid ? 'paid' : 'claim') : 'unpaid'}}">
        {{order.payStatusText}}
      </view>
      <view wx:if="{{!order.paid && order.status === 'pending'}}" class="pay-now-btn" bindtap="onPayTap">去支付 →</view>
      <view wx:if="{{canCancel}}" class="cancel-btn" bindtap="onCancelOrder">取消订单</view>
    </view>

    <!-- 书籍信息 -->
    <view class="info-card">
      <text class="card-title">商品信息</text>

      <block wx:if="{{order.isBatch}}">
        <view class="book-item" wx:for="{{order.items}}" wx:key="bookId" wx:for-item="bk">
          <image wx:if="{{bk.coverUrl}}" src="{{bk.coverUrl}}" mode="aspectFill" class="book-thumb"/>
          <view wx:else class="book-thumb-ph">📖</view>
          <view class="book-meta">
            <text class="book-name">{{bk.title}}</text>
            <text class="book-price">¥{{bk.price}}</text>
          </view>
        </view>
        <view class="price-summary">
          <view class="price-row">
            <text>商品总价</text>
            <text>¥{{order.totalPrice}}</text>
          </view>
          <view class="price-row" wx:if="{{order.deliveryFee > 0}}">
            <text>配送费 ({{order.items.length}}本 × ¥1)</text>
            <text>+¥{{order.deliveryFee}}</text>
          </view>
          <view class="price-row total">
            <text>实付金额</text>
            <text class="total-num">¥{{order.totalAmount}}</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="book-item">
          <image wx:if="{{order.bookCover}}" src="{{order.bookCover}}" mode="aspectFill" class="book-thumb"/>
          <view wx:else class="book-thumb-ph">📖</view>
          <view class="book-meta">
            <text class="book-name">{{order.bookTitle}}</text>
            <text class="book-price">¥{{order.price}}</text>
          </view>
        </view>
        <view class="price-summary">
          <view class="price-row">
            <text>商品总价</text>
            <text>¥{{order.price}}</text>
          </view>
          <view class="price-row" wx:if="{{order.deliveryFee > 0}}">
            <text>配送费</text>
            <text>+¥{{order.deliveryFee}}</text>
          </view>
          <view class="price-row total">
            <text>实付金额</text>
            <text class="total-num">¥{{order.totalAmount}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 配送信息 -->
    <view class="info-card">
      <text class="card-title">配送与联系信息</text>
      <view class="info-row">
        <text class="info-label">交易方式</text>
        <text class="info-value">{{order.deliveryType === 'delivery' ? '🚚 送货上门' : '📍 校园自提'}}</text>
      </view>
      <view class="info-row" wx:if="{{order.address}}">
        <text class="info-label">地址</text>
        <text class="info-value">{{order.address}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">联系人</text>
        <text class="info-value">{{order.buyerName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{order.buyerPhone}}</text>
      </view>
    </view>
  </block>
</view>
