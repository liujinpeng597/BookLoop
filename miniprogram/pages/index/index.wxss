page {
  background-color: #f1f5f9;
}

.container {
  min-height: 100vh;
}

/* 导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #f1f5f9;
  z-index: 999;
  display: flex;
  align-items: center;
  box-sizing: content-box;
}

.nav-title {
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

/* Header */
.header {
  padding: 24rpx 32rpx 10rpx;
}
.app-name {
  font-size: 44rpx;
  font-weight: 900;
  color: #1e293b;
  display: block;
}
.app-sub {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  display: block;
}

/* 搜索栏 */
.search-section {
  padding: 24rpx 32rpx;
  position: sticky;
  top: calc(env(safe-area-inset-top) + 88rpx); /* 根据导航栏大致高度吸顶 */
  z-index: 100;
  background: #f1f5f9;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  height: 88rpx;
  border-radius: 44rpx;
  padding: 0 12rpx 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.search-icon {
  font-size: 32rpx;
  color: #94a3b8;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
  height: 100%;
}
.search-btn {
  background: #f97316;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0 32rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
}
.search-btn:active {
  opacity: 0.8;
}

/* 分类 Tab */
.category-scroll {
  width: 100%;
  padding: 10rpx 0 20rpx;
}
.category-list {
  display: flex;
  padding: 0 32rpx;
}
.category-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 30rpx;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.02);
}
.category-item.active {
  background: #f97316;
  color: #ffffff;
  font-weight: bold;
}

/* 公告栏 */
.notice-bar {
  margin: 0 32rpx 9rpx;
  background: linear-gradient(135deg, #fff7ed, #fff3e0);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #f97316;
}
.notice-content {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.notice-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.notice-text {
  font-size: 26rpx;
  color: #ea580c;
  line-height: 1.5;
  font-weight: 500;
}

/* 书籍列表瀑布流/网格 */
.book-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 16rpx 32rpx;
}

.book-card {
  width: 48%; /* 让一行显示两本 */
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.03);
  display: flex;
  flex-direction: column;
}
.book-card:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

.book-cover-wrap {
  width: 100%;
  height: 380rpx;
  background: #f8fafc;
  position: relative;
}
.book-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.book-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  color: #cbd5e1;
}

/* 左上角品相标签 */
.condition-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
/* 品相颜色字典 */
.cond-quanxin { background: rgba(34, 197, 94, 0.9); color: #fff; }
.cond-jiuchenxin { background: rgba(59, 130, 246, 0.9); color: #fff; }
.cond-bachenxin { background: rgba(245, 158, 11, 0.9); color: #fff; }
.cond-qichenxin { background: rgba(239, 68, 68, 0.9); color: #fff; }
.cond-other { background: rgba(100, 116, 139, 0.9); color: #fff; }

.book-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.book-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-author {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.book-price {
  font-size: 34rpx;
  font-weight: 900;
  color: #ea580c;
  margin-right: 12rpx;
}
.book-orig {
  font-size: 22rpx;
  color: #cbd5e1;
  text-decoration: line-through;
}
.book-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}
.meta-views {
  font-size: 22rpx;
  color: #94a3b8;
}
.meta-category {
  background: #f1f5f9;
  color: #64748b;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

/* 底部状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon { font-size: 100rpx; opacity: 0.5; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #94a3b8; }

.loading-state, .no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #cbd5e1;
}