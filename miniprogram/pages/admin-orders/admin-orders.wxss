page { 
  background: #f1f5f9; 
}

/* 导航栏 */
.custom-nav { 
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  background: #ffffff; 
  z-index: 999; 
  display: flex; 
  align-items: center; 
}
.nav-back { 
  position: absolute; 
  left: 0; 
  padding: 0 32rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  z-index: 1000; 
}
.back-icon { 
  font-size: 36rpx; 
  color: #1e293b; 
  font-weight: bold; 
}
.nav-title { 
  width: 100%; 
  text-align: center; 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #1e293b; 
}

/* 顶部筛选栏 */
.filter-bar { 
  white-space: nowrap; 
  padding: 24rpx; 
  background: #fff; 
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03); 
  position: sticky;
  top: 0;
  z-index: 998;
}
.filter-btn { 
  display: inline-block; 
  padding: 12rpx 32rpx; 
  margin-right: 20rpx; 
  background: #f1f5f9; 
  border-radius: 30rpx; 
  font-size: 28rpx; 
  color: #64748b; 
  transition: all 0.2s ease;
}
.filter-active { 
  background: #f97316; 
  color: #fff; 
  font-weight: bold; 
}

/* 列表容器 */
.order-list { 
  padding: 24rpx; 
}

/* 单个订单卡片 */
.order-card { 
  background: #fff; 
  border-radius: 24rpx; 
  padding: 30rpx; 
  margin-bottom: 24rpx; 
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); 
}

/* 订单号与状态 */
.order-header { 
  display: flex; 
  justify-content: space-between; 
  margin-bottom: 24rpx; 
  font-size: 26rpx; 
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #e2e8f0;
}
.order-no { color: #94a3b8; }
.status-pending { color: #f97316; font-weight: bold; }
.status-shipped { color: #3b82f6; font-weight: bold; }
.status-completed { color: #10b981; font-weight: bold; }
.status-cancelled { color: #94a3b8; font-weight: bold; }

.pay-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  font-weight: 600;
}
.pay-tag.paid {
  background: #d1fae5;
  color: #059669;
}
.pay-tag.unpaid {
  background: #fef3c7;
  color: #d97706;
}
/* 买家自报已转账、待卖家核实 */
.pay-tag.claim {
  background: #ffedd5;
  color: #ea580c;
}

/* 列表底部加载提示 */
.load-more {
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  padding: 16rpx 0 40rpx;
}

/* 书籍信息展示块 */
.order-book { 
  display: flex; 
  margin-bottom: 24rpx; 
  background: #f8fafc; 
  padding: 20rpx; 
  border-radius: 16rpx; 
}
.book-thumb, .book-thumb-ph { 
  width: 100rpx; 
  height: 130rpx; 
  border-radius: 12rpx; 
}
.book-thumb-ph { 
  background: #e2e8f0; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 40rpx; 
}
.book-info { 
  margin-left: 20rpx; 
  display: flex; 
  flex-direction: column; 
  justify-content: center; 
}
.book-title { 
  font-size: 28rpx; 
  font-weight: 800; 
  color: #1e293b; 
  margin-bottom: 12rpx; 
}
.book-price { 
  font-size: 34rpx; 
  color: #ea580c; 
  font-weight: 900; 
}

/* 买家信息展示块 */
.buyer-info { 
  background: #ffedd5; 
  padding: 24rpx; 
  border-radius: 16rpx; 
  margin-bottom: 30rpx; 
}
.buyer-row { 
  display: block; 
  font-size: 26rpx; 
  color: #ea580c; 
  margin-bottom: 10rpx; 
  font-weight: 500; 
}
.buyer-row:last-child {
  margin-bottom: 0;
}

/* 底部操作按钮 */
.action-row { 
  display: flex; 
  justify-content: flex-end; 
  gap: 24rpx; 
}
.action-btn { 
  padding: 16rpx 36rpx; 
  border-radius: 40rpx; 
  font-size: 26rpx; 
  font-weight: bold; 
}
.btn-ship { background: #f97316; color: #fff; }
.btn-complete { background: #10b981; color: #fff; }
.btn-cancel { background: #f1f5f9; color: #64748b; }

/* 页面空白与加载状态 */
.empty { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  margin-top: 200rpx; 
}
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; opacity: 0.5; }
.empty-text { color: #94a3b8; font-size: 28rpx; }
.loading { text-align: center; color: #94a3b8; padding: 60rpx; font-size: 28rpx; }

.order-action-row {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx dashed #f1f5f9;
}
.btn-delete {
  font-size: 24rpx;
  color: #64748b;
  background-color: #f1f5f9;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

/* 多书订单 */
.batch-books {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 16rpx;
}
.batch-book-item {
  display: flex;
  align-items: center;
}
.book-thumb-sm, .book-thumb-ph-sm {
  width: 70rpx;
  height: 90rpx;
  border-radius: 8rpx;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.book-info-sm {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.book-title-sm {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}
.book-price-sm {
  font-size: 28rpx;
  color: #ea580c;
  font-weight: 800;
}
.batch-total {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #1e293b;
}
.fee-tag {
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}