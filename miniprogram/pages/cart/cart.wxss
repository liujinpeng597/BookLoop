page {
  background: #f1f5f9;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #f1f5f9;
  z-index: 999;
  display: flex;
  align-items: center;
  box-sizing: content-box;
}
.nav-title {
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #94a3b8;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
.empty-text {
  color: #94a3b8;
  font-size: 28rpx;
}

/* 列表 */
.cart-list {
  flex: 1;
  padding: 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}

/* 复选框 */
.check-box {
  padding: 8rpx;
  flex-shrink: 0;
}
.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.15s;
}
.check-circle.checked {
  background: #f97316;
  border-color: #f97316;
}

/* 商品图 */
.item-thumb {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.item-thumb-ph {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 商品信息 */
.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.item-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.item-meta {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}
.item-price {
  font-size: 34rpx;
  font-weight: 900;
  color: #ea580c;
}

/* 删除按钮 */
.delete-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.delete-icon {
  font-size: 28rpx;
  color: #cbd5e1;
}

/* 配送方式 */
.delivery-card {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.delivery-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
  display: block;
  margin-bottom: 20rpx;
}
.radio-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.radio-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}
.radio-label radio {
  transform: scale(0.85);
  margin-right: 10rpx;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.04);
  z-index: 100;
}
.check-all {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}
.check-all-text {
  font-size: 26rpx;
  color: #64748b;
  margin-left: 10rpx;
}

.total-section {
  flex: 1;
  display: flex;
  align-items: baseline;
}
.total-label {
  font-size: 26rpx;
  color: #64748b;
}
.total-price {
  font-size: 40rpx;
  font-weight: 900;
  color: #ea580c;
}

.checkout-btn {
  background: linear-gradient(135deg, #f97316, #fb923c);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 18rpx 44rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 18rpx rgba(249, 115, 22, 0.25);
  flex-shrink: 0;
}
.checkout-btn.disabled {
  background: #cbd5e1;
  box-shadow: none;
}
