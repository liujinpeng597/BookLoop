page {
  background-color: #f1f5f9;
}

/* ================ 导航栏 ================ */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #f1f5f9;
  z-index: 999;
  display: flex;
  align-items: center;
  box-sizing: content-box; /* 强制取消内边距挤压 */
}

.nav-title { 
  width: 100%; 
  text-align: center; 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #1e293b; 
}

/* ================ Header ================ */
.header { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  padding: 24rpx 24rpx 10rpx; 
  box-sizing: border-box; 
}
.header-left { 
  display: flex; 
  flex-direction: column; 
}
.app-name { 
  font-size: 44rpx; 
  font-weight: 800; 
  color: #1e293b; 
}
.app-sub { 
  font-size: 24rpx; 
  color: #94a3b8; 
  margin-top: 6rpx; 
}

/* ================ 列表区域 ================ */
.msg-list { 
  padding: 24rpx; 
  overflow-x: hidden; 
}

/* ================ 滑动组件魔法 ================ */
.swipe-area { 
  width: 100%; 
  height: 160rpx; 
  margin-bottom: 24rpx; 
  border-radius: 24rpx; 
  overflow: hidden; /* 没划开的时候，把右边的按钮强行隐藏掉 */
}

.swipe-view { 
  /* 视窗宽度 = 屏幕可用宽度 + 隐藏在右侧的删除按钮宽度 */
  width: calc(100% + 140rpx); 
  height: 100%; 
  z-index: 2; 
}

.swipe-content {
  display: flex; /* 火车头+车厢的横向拼接 */
  width: 100%;
  height: 100%;
}

/* ================ 卡片本体 ================ */
.msg-item {
  /* 强制撑满屏幕，不能被挤压变形 (100vw - 左右两边内边距 48rpx) */
  width: calc(100vw - 48rpx); 
  height: 100%;
  flex-shrink: 0; 
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.msg-item:active { 
  background-color: #f8fafc; 
}

/* ================ 删除按钮 ================ */
.delete-btn {
  width: 140rpx;
  height: 100%;
  flex-shrink: 0;
  background-color: #ef4444;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

/* ================ 头像与图标渐变 ================ */
.avatar-box { 
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 28rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin-right: 28rpx; 
  flex-shrink: 0; 
}
.avatar-icon { 
  font-size: 56rpx; 
}

/* 根据消息类型智能匹配极其柔和的渐变底色 */
.type-chat { background: linear-gradient(135deg, #ffedd5, #fed7aa); }
.type-order { background: linear-gradient(135deg, #e0f2fe, #bae6fd); }
.type-shipping { background: linear-gradient(135deg, #dcfce7, #bbf7d0); }
.type-arrival { background: linear-gradient(135deg, #fce7f3, #fbcfe8); }
.type-notice { background: linear-gradient(135deg, #f3e8ff, #e9d5ff); }

/* ================ 文字排版区 ================ */
.msg-content { 
  flex: 1; 
  min-width: 0; 
  display: flex; 
  flex-direction: column; 
  justify-content: center; 
}
.msg-header { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 10rpx; 
}
.msg-title { 
  font-size: 32rpx; 
  font-weight: 700; 
  color: #1e293b; 
}
.msg-time { 
  font-size: 24rpx; 
  color: #94a3b8; 
}
.msg-desc { 
  font-size: 28rpx; 
  color: #64748b; 
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
}

/* ================ 空状态 ================ */
.empty { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  margin-top: 200rpx; 
}
.empty-icon { 
  font-size: 100rpx; 
  margin-bottom: 20rpx; 
  opacity: 0.5; 
}
.empty-text { 
  color: #94a3b8; 
  font-size: 28rpx; 
}